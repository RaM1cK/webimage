# Flask
FLASK_ENV=development
SECRET_KEY=change-me-secret
JWT_SECRET_KEY=change-me-jwt-secret
JWT_ACCESS_TOKEN_EXPIRES=600
JWT_REFRESH_TOKEN_EXPIRES=604800
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAMESITE=Lax
JWT_COOKIE_CSRF_PROTECT=true

# Postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=webimage
POSTGRES_USER=webimage
POSTGRES_PASSWORD=webimage

# Redis
REDIS_URL=redis://redis:6379/0

# S3 / Object storage (LocalStack/MinIO compatible)
S3_ENDPOINT_URL=http://localstack:4566
S3_PUBLIC_ENDPOINT_URL=http://localhost:4566
S3_ACCESS_KEY=test
S3_SECRET_KEY=test
S3_BUCKET=webimage
S3_REGION=us-east-1
S3_USE_SSL=false

# Frontend
CLIENT_ORIGIN=http://localhost:3000
